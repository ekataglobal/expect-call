{:paths ["src" "resources"]
 :deps {org.clojure/core.match {:mvn/version "1.1.1"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :hooks {:deps
          {clj-kondo/clj-kondo
           {:git/url "https://github.com/clj-kondo/clj-kondo.git"
            :git/tag "v2025.09.22"
            :git/sha "507c407"}}
          :paths ["resources/clj-kondo.exports/whitepages/expect-call"]
          :ns-aliases {hooks hooks.whitepages.expect-call}}
  :lint {:deps
         {clj-kondo/clj-kondo
          {:git/url "https://github.com/clj-kondo/clj-kondo.git"
           :git/tag "v2025.09.22"
           :git/sha "507c407"}}
         :main-opts ["-m" "clj-kondo.main" "--parallel" "--lint"]}}}
