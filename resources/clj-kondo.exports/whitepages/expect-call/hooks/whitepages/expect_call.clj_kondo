(ns hooks.whitepages.expect-call
  (:require [clj-kondo.hooks-api :as api]))

;; region validation

(def known-tags #{:do :more :never :any-order})

(def findings
  {:expect-call/expectations-missing
   "Needs expected-fn(s): (fn arg-match body...) or [(fn arg-match body...)...], each fn may be preceded by keywords :do, :more, :any-order or :never."
   :expect-call/empty-body "Empty expect-call body"
   :expect-call/empty-expectations "No expected calls"
   :expect-call/fspec "Must be (fn-name arg-match body...), fn-name may be preceded by keywords :do, :more, :any-order or :never."
   :expect-call/duplicate-tag "Duplicate tag"
   :expect-call/unknown-tag "Unknown tag"
   :expect-call/never-with-other-tags "No tags should be used together with :never"
   :expect-call/any-order-with-more ":any-order and :more can't be used together"
   :expect-call/no-fn-name "Must be followed by a symbol representing a fn name"
   :expect-call/fn-name "Must be a symbol representing a fn name"
   :expect-call/never-with-args "No args or body should be used with :never"
   :expect-call/args "Must be a core.match pattern - see https://github.com/clojure/core.match/wiki/Overview"
   :expect-call/var-wildcard
   "Pattern symbol %s is not a local: core.match binds it as a wildcard instead of comparing with var %s. Use a local, (_ :guard #(= %% %s)), or _ if any value is fine."})

(defn reg-finding!
  "Registers a finding on node with finding-type. Returns nil"
  [node finding-type]
  (-> node
      (meta)
      (merge {:type finding-type :message (get findings finding-type)})
      (api/reg-finding!))
  nil)

(defn validate-args-node! [args-node]
  (or (nil? args-node)
      (api/vector-node? args-node)
      (reg-finding! args-node :expect-call/args)))

(defn valid-tag!
  "Returns unseen valid tag or nil. Regs findings on node."
  [{:keys [k] :as node} seen-tags]
  (cond
    (contains? seen-tags k)
    (reg-finding! node :expect-call/duplicate-tag)

    (not (contains? known-tags k))
    (reg-finding! node :expect-call/unknown-tag)

    :else
    (do (when (or (contains? seen-tags :never)
                  (and (= :never k) (seq seen-tags)))
          (reg-finding! node :expect-call/never-with-other-tags))
        (when (or (and (= :any-order k) (contains? seen-tags :more))
                  (and (= :more k) (contains? seen-tags :any-order)))
          (reg-finding! node :expect-call/any-order-with-more))
        k)))

(defn valid-tags+rest!
  "Returns a vector containing the set of valid tags and the rest of the children.
  Regs findings on tag nodes."
  [expected-fn-children]
  (into
   [(transduce
     (take-while api/keyword-node?)
     (completing
      (fn [seen-tags node]
        (if-let [tag (valid-tag! node seen-tags)]
          (conj seen-tags tag)
          seen-tags)))
     #{}
     expected-fn-children)]
   (drop-while api/keyword-node?)
   expected-fn-children))

(defn symbol-node? [node]
  (and (api/token-node? node)
       (symbol? (:value node))))

(defn validate-expected-fn-children! [children]
  (let [[tags fn-name args] (valid-tags+rest! children)]
    (cond
      (nil? fn-name)
      (reg-finding! (last children) :expect-call/no-fn-name)

      (not (symbol-node? fn-name))
      (reg-finding! fn-name :expect-call/fn-name)

      (and (:never tags) (some? args))
      (reg-finding! args :expect-call/never-with-args)

      :else
      (validate-args-node! args))))

(defn validate-expected-fn-node! [expected-fn-node]
  (if (or (not (api/list-node? expected-fn-node))
          (empty? (:children expected-fn-node)))
    (reg-finding! expected-fn-node :expect-call/fspec)
    (validate-expected-fn-children! (:children expected-fn-node))))

(defn validate-expected-fns-node! [{:keys [children] :as expected-fns-node}]
  (if (empty? children)
    (reg-finding! expected-fns-node :expect-call/empty-expectations)
    (not-any? nil? (mapv validate-expected-fn-node! children))))

(defn validate-expectations-node! [expectation-node]
  (if (api/vector-node? expectation-node)
    (validate-expected-fns-node! expectation-node)
    (validate-expected-fn-node! expectation-node)))

(defn validate!
  "Returns truthy if validation succeeded. Records findings if there are any."
  [expect-call-node]
  (let [[expectations-node & body] (rest (:children expect-call-node))]
    (when (empty? body)
      (reg-finding! expect-call-node :expect-call/empty-body))
    (if (nil? expectations-node)
      (reg-finding! expect-call-node :expect-call/expectations-missing)
      (validate-expectations-node! expectations-node))))

;; endregion validation

;; region transformation

(defn ->expected-fn-nodes [expected-fns-node]
  (if (api/vector-node? expected-fns-node)
    (:children expected-fns-node)
    [expected-fns-node]))

(defn- var-wildcard-node
  "If arg-node is a simple symbol that resolves to a var (api/resolve returns nil
  for locals and _ or &),
  core.match will treat it as a wildcard binding. Registers a dedicated finding
  and returns the node with :clj-kondo/ignore metadata so clj-kondo does not also
  report the binding as :shadowed-var / :unused-binding. Returns nil otherwise."
  [arg-node]
  (let [sym (api/sexpr arg-node)]
    (when-let [{var-ns :ns var-name :name} (api/resolve {:name sym})]
      (api/reg-finding!
       (merge (meta arg-node)
              {:type :expect-call/var-wildcard
               :message (format (get findings :expect-call/var-wildcard)
                                sym (symbol (str var-ns) (str var-name)) sym)}))
      (vary-meta arg-node assoc :clj-kondo/ignore [:shadowed-var :unused-binding]))))

(def ^:private list-pattern-ops
  "core.match (pattern op operand) operators whose operand is an expression, not a pattern"
  #{:guard :when :<<})

(def ^:private flattened-pattern-ops
  "Operators core.match regroups from flattened vector syntax: [p :guard pred] -> [(p :guard pred)].
  :<< is not regrouped, so [p :<< f] is three separate patterns."
  #{:guard :when})

(defn- pattern-op? [ops node]
  (and (api/keyword-node? node) (contains? ops (:k node))))

(defn- prepare-pattern
  "Walks a core.match pattern node in the positions clj-kondo's core.match
  analyzer treats as patterns. Flags non-local symbols that resolve to vars
  (see var-wildcard-node). Map keys are expressions, not patterns."
  [node]
  (cond
    (and (symbol-node? node) (simple-symbol? (:value node)))
    (or (var-wildcard-node node) node)

    ;; (pattern :guard pred), (pattern :when pred), (pattern :<< f): only the first child is a pattern
    (api/list-node? node)
    (let [[pattern op & more :as children] (:children node)]
      (assoc node :children
             (if (pattern-op? list-pattern-ops op)
               (list* (prepare-pattern pattern) op more)
               ;; eager: api/resolve only works during the hook call
               (doall (map #(prepare-pattern %) children)))))

    ;; flattened [pattern :guard pred ...] syntax
    (api/vector-node? node)
    (assoc node :children
           (loop [[child & more] (:children node) acc []]
             (cond
               (nil? child) acc
               (and (pattern-op? flattened-pattern-ops (first more)) (next more))
               (recur (nnext more) (conj acc (prepare-pattern child) (first more) (second more)))
               :else (recur more (conj acc (prepare-pattern child))))))

    (api/map-node? node)
    (assoc node :children
           (into []
                 (comp (partition-all 2)
                       (mapcat (fn [[k v]]
                                 (cond-> [k]
                                   v (conj (prepare-pattern v))))))
                 (:children node)))

    :else node))

(let [drop-while-keyword-xf (drop-while api/keyword-node?)]
  (defn redefed-fn
    "Transforms expected fn spec into a pair usable with with-redefs:
    fn-name (fn [& args] (clojure.core.match/match (vec args) pattern (do body...) :else nil))
    so that clj-kondo's built-in core.match analysis handles the pattern."
    [{:keys [children]}]
    (let [[fn-name-node args-node & body] (into [] drop-while-keyword-xf children)
          args-sym (api/token-node (gensym "args"))
          pattern (if args-node
                    (prepare-pattern args-node)
                    (api/vector-node [(api/token-node '&) (api/token-node '_)]))]
      [fn-name-node
       (api/list-node
        [(api/token-node 'fn)
         (api/vector-node [(api/token-node '&) args-sym])
         (api/list-node
          [(api/token-node 'clojure.core.match/match)
           (api/list-node [(api/token-node 'vec) args-sym])
           pattern
           (api/list-node (list* (api/token-node 'do) body))
           (api/keyword-node :else)
           (api/token-node nil)])])])))

(let [mapcat-redefed-fn-xf (mapcat redefed-fn)]
  (defn ->with-redefs [expect-call-node]
    (let [[expectations-node & body] (rest (:children expect-call-node))]
      (-> expectations-node
          (->expected-fn-nodes)
          (->> (into [] mapcat-redefed-fn-xf))
          (api/vector-node)
          (as-> $ (list* (api/token-node 'with-redefs) $ body))
          (api/list-node)
          #_(doto (-> api/sexpr prn))))))

;; endregion transformation

(defn expect-call [{:keys [node]}]
  (when (validate! node)
    {:node (->with-redefs node)}))
